# Reference values for local deployment. The exported n8n workflows do not
# automatically load this file. Use n8n credentials or a secret manager.

COMFYUI_URL=http://127.0.0.1:8188
OLLAMA_URL=http://127.0.0.1:11434
INSTAGRAM_ACCOUNT_ID=replace-with-instagram-professional-account-id
META_ACCESS_TOKEN=replace-with-meta-access-token
IMGBB_API_KEY=replace-with-imgbb-api-key
PUBLIC_MEDIA_BASE_URL=https://replace-with-public-https-host
REEL_OUTPUT_DIR=/path/visible-to-n8n-and-comfyui