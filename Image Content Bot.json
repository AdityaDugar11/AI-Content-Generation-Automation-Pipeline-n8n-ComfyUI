    {
      "parameters": {
        "jsCode": "const response = $input.first().json.response;\n// Extract JSON from Ollama's text response\nconst jsonMatch = response.match(/\\{[\\s\\S]*\\}/);\nconst parsed = JSON.parse(jsonMatch[0]);\nreturn [{\n  json: {\n    image_prompt: parsed.image_prompt,\n    instagram_caption: parsed.instagram_caption,\n    facebook_description: parsed.facebook_description\n  }\n}];"
      },
